---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { JOURNEES } from '../lib/rubriques';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, categories } = Astro.props;
const rubrique = categories.includes(JOURNEES) ? '/journees-paul-valery' : '/blog';
---

<html lang="fr">
	<head>
		<BaseHead
			title={title}
			description={description || `Reportage photographique de Gilles Hutchinson : ${title}.`}
		/>
		<style>
			main {
				width: auto;
				max-width: none;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* ---------- Visionneuse ---------- */
			.lb-overlay {
				position: fixed;
				inset: 0;
				z-index: 9999;
				background-color: #faf9f6;
				color: rgb(var(--black));
				display: none;
				flex-direction: column;
			}
			.lb-overlay.is-open {
				display: flex;
			}
			.lb-toolbar {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.9rem 1.25rem;
			}
			.lb-counter {
				margin-right: auto;
				font-size: 0.78rem;
				letter-spacing: 0.14em;
				color: var(--accent);
				font-variant-numeric: tabular-nums;
			}
			.lb-btn {
				background: transparent;
				border: 1px solid rgb(var(--gray-light));
				color: rgb(var(--black));
				padding: 0.45rem 0.9rem;
				font: inherit;
				font-size: 0.75rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				border-radius: 2px;
				cursor: pointer;
				transition: border-color 0.2s ease, color 0.2s ease;
			}
			.lb-btn:hover,
			.lb-btn:focus-visible {
				border-color: var(--accent);
				color: var(--accent);
			}
			.lb-btn[hidden] {
				display: none;
			}
			.lb-stage {
				position: relative;
				flex: 1;
				min-height: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.7rem;
				padding: 0 4.5rem;
				touch-action: pan-y pinch-zoom;
			}
			.lb-img {
				max-width: 100%;
				/* place réservée à la légende, juste sous la photo */
				max-height: calc(100% - 4.6rem);
				width: auto;
				height: auto;
				object-fit: contain;
				margin: 0;
				border-radius: 2px;
				box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
				cursor: default;
				transition: opacity 0.25s ease;
			}
			.lb-img:hover {
				transform: none;
			}
			.lb-overlay.is-loading .lb-img {
				opacity: 0.35;
			}
			.lb-spinner {
				position: absolute;
				width: 34px;
				height: 34px;
				border: 2px solid rgb(var(--gray-light));
				border-top-color: var(--accent);
				border-radius: 50%;
				opacity: 0;
				pointer-events: none;
				animation: lb-tourne 0.9s linear infinite;
				transition: opacity 0.2s ease 0.15s;
			}
			.lb-overlay.is-loading .lb-spinner {
				opacity: 1;
			}
			@keyframes lb-tourne {
				to {
					transform: rotate(360deg);
				}
			}
			.lb-nav {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				width: 3.25rem;
				height: 3.25rem;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(250, 249, 246, 0.85);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 50%;
				color: rgb(var(--black));
				font-size: 1.8rem;
				line-height: 1;
				cursor: pointer;
				transition: border-color 0.2s ease, color 0.2s ease;
			}
			.lb-nav:hover,
			.lb-nav:focus-visible {
				border-color: var(--accent);
				color: var(--accent);
			}
			.lb-prev {
				left: 0.75rem;
			}
			.lb-next {
				right: 0.75rem;
			}
			.lb-caption {
				flex: none;
				max-width: 900px;
				margin: 0;
				padding: 0 1.25rem;
				text-align: center;
				font-size: 0.9rem;
				line-height: 1.5;
				color: rgb(var(--gray));
			}
			.lb-strip {
				flex: none;
				display: flex;
				justify-content: safe center;
				gap: 6px;
				overflow-x: auto;
				padding: 0.75rem 1.25rem 0.9rem;
				scrollbar-width: thin;
				scroll-behavior: smooth;
			}
			.lb-strip[hidden] {
				display: none;
			}
			:global(.lb-thumb) {
				flex: none;
				height: 64px;
				padding: 0;
				border: 2px solid transparent;
				border-radius: 3px;
				background: rgb(var(--gray-light));
				cursor: pointer;
				opacity: 0.55;
				transition: opacity 0.2s ease, border-color 0.2s ease;
			}
			:global(.lb-thumb:hover),
			:global(.lb-thumb:focus-visible) {
				opacity: 1;
			}
			:global(.lb-thumb.is-active) {
				border-color: var(--accent);
				opacity: 1;
			}
			:global(.lb-thumb img) {
				display: block;
				height: 100%;
				width: auto;
				margin: 0;
				border-radius: 1px;
				box-shadow: none;
				object-fit: cover;
			}
			:global(.lb-thumb img:hover) {
				transform: none;
			}
			@media (max-width: 720px) {
				.lb-stage {
					padding: 0;
					gap: 0.5rem;
				}
				.lb-img {
					max-height: calc(100% - 6rem);
				}
				:global(.lb-thumb) {
					height: 48px;
				}
				.lb-strip {
					padding: 0.6rem 0.75rem 0.75rem;
				}
				.lb-nav {
					display: none;
				}
				.lb-toolbar {
					padding: 0.75rem;
					gap: 0.5rem;
				}
				.lb-btn {
					padding: 0.4rem 0.65rem;
					white-space: nowrap;
				}
				.lb-full {
					display: none;
				}
				.lb-caption {
					font-size: 0.82rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.lb-img,
				.lb-spinner {
					transition: none;
				}
			}
		</style>
	</head>

	<body>
		<Header current={rubrique} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Mis à jour le <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<nav class="sommaire-photos" aria-label="Sections du reportage"></nav>
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<div
			id="lightbox"
			class="lb-overlay"
			role="dialog"
			aria-modal="true"
			aria-label="Visionneuse de photos"
			aria-hidden="true"
		>
			<div class="lb-toolbar">
				<span id="lb-counter" class="lb-counter" aria-live="polite"></span>
				<button id="lb-play" class="lb-btn" type="button">▶ Diaporama</button>
				<button id="lb-full" class="lb-btn lb-full" type="button" hidden>Plein écran</button>
				<button id="lb-close" class="lb-btn" type="button" aria-label="Fermer la visionneuse">✕ Fermer</button>
			</div>
			<figure class="lb-stage" id="lb-stage">
				<img id="lb-img" class="lb-img" alt="" />
				<span class="lb-spinner" aria-hidden="true"></span>
				<button id="lb-prev" class="lb-nav lb-prev" type="button" aria-label="Photo précédente">‹</button>
				<button id="lb-next" class="lb-nav lb-next" type="button" aria-label="Photo suivante">›</button>
				<figcaption id="lb-caption" class="lb-caption"></figcaption>
			</figure>
			<nav id="lb-strip" class="lb-strip" aria-label="Photos de la section"></nav>
		</div>

		<script is:inline>
			(() => {
				// Les photos sont regroupées par section (« Les salles du musée », « Avec la presse »,
				// « Vernissage »…) : la visionneuse, son compteur et ses vignettes restent dans la section.
				const groupes = [];
				let groupe = null;
				document
					.querySelectorAll('.prose h2.section-photos, .prose figure.photo-figure img')
					.forEach((el) => {
						if (el.tagName === 'H2') {
							groupe = null;
							groupes.push((groupe = { titre: el.textContent.trim(), photos: [] }));
							return;
						}
						if (!groupe) groupes.push((groupe = { titre: '', photos: [] }));
						groupe.photos.push(el);
					});
				const sections = groupes.filter((g) => g.photos.length);
				if (!sections.length) return;
				const groupeDe = new Map();
				sections.forEach((g) => g.photos.forEach((img, i) => groupeDe.set(img, { g, i })));

				const $ = (id) => document.getElementById(id);
				const overlay = $('lightbox');
				const stage = $('lb-stage');
				const lbImg = $('lb-img');
				const counter = $('lb-counter');
				const caption = $('lb-caption');
				const btnPlay = $('lb-play');
				const btnFull = $('lb-full');
				const btnClose = $('lb-close');
				const strip = $('lb-strip');
				const INTERVALLE = 4000;

				let section = sections[0];
				let photos = section.photos;
				let vignettes = [];
				let courant = 0;
				let minuteur = null;
				let demande = 0;
				let declencheur = null;

				const source = (img) => img.dataset.full || img.currentSrc || img.src;
				const legende = (img) =>
					img.closest('figure')?.querySelector('figcaption')?.textContent.trim() || img.alt || '';

				const prechargees = new Map();
				function precharger(i) {
					const img = photos[(i + photos.length) % photos.length];
					const url = source(img);
					if (!prechargees.has(url)) {
						const p = new Image();
						p.decoding = 'async';
						p.src = url;
						prechargees.set(url, p);
					}
					return prechargees.get(url);
				}

				function afficher(i) {
					courant = (i + photos.length) % photos.length;
					const img = photos[courant];
					const url = source(img);
					const numero = ++demande;

					counter.textContent = `${section.titre ? section.titre + ' · ' : ''}${courant + 1} / ${photos.length}`;
					caption.textContent = legende(img);
					lbImg.alt = img.alt || '';
					marquerVignette();

					const chargee = precharger(courant);
					const poser = () => {
						if (numero !== demande) return;
						lbImg.src = url;
						overlay.classList.remove('is-loading');
					};
					if (chargee.complete && chargee.naturalWidth) {
						poser();
					} else {
						// En attendant la photo d'origine, on montre la vignette déjà chargée.
						lbImg.src = img.currentSrc || img.src;
						overlay.classList.add('is-loading');
						chargee.addEventListener('load', poser, { once: true });
						chargee.addEventListener('error', () => {
							if (numero === demande) overlay.classList.remove('is-loading');
						}, { once: true });
					}
					precharger(courant + 1);
					precharger(courant - 1);
				}

				function lancer() {
					arreter();
					minuteur = setInterval(() => afficher(courant + 1), INTERVALLE);
					btnPlay.textContent = '⏸ Pause';
				}
				function arreter() {
					if (minuteur) clearInterval(minuteur);
					minuteur = null;
					btnPlay.textContent = '▶ Diaporama';
				}
				const bascule = () => (minuteur ? arreter() : lancer());
				const precedente = () => { arreter(); afficher(courant - 1); };
				const suivante = () => { arreter(); afficher(courant + 1); };

				// Bande de vignettes de la section en bas de la visionneuse
				function construireBande() {
					strip.replaceChildren();
					vignettes = photos.map((img, k) => {
						const b = document.createElement('button');
						b.type = 'button';
						b.className = 'lb-thumb';
						b.setAttribute('aria-label', `Photo ${k + 1} sur ${photos.length}`);
						const v = document.createElement('img');
						v.src = img.currentSrc || img.src;
						v.alt = '';
						v.loading = 'lazy';
						v.decoding = 'async';
						const w = Number(img.getAttribute('width'));
						const h = Number(img.getAttribute('height'));
						if (w && h) {
							v.width = Math.round((64 * w) / h);
							v.height = 64;
						}
						b.append(v);
						b.addEventListener('click', () => { arreter(); afficher(k); });
						strip.append(b);
						return b;
					});
					strip.hidden = photos.length < 2;
				}
				function marquerVignette() {
					vignettes.forEach((b, k) => {
						const actif = k === courant;
						b.classList.toggle('is-active', actif);
						if (actif) b.setAttribute('aria-current', 'true');
						else b.removeAttribute('aria-current');
					});
					const b = vignettes[courant];
					if (b && !strip.hidden) {
						strip.scrollTo({ left: b.offsetLeft - strip.clientWidth / 2 + b.offsetWidth / 2 });
					}
				}

				function ouvrir(imgCliquee) {
					declencheur = document.activeElement;
					const { g, i } = groupeDe.get(imgCliquee);
					if (g !== section || !vignettes.length) {
						section = g;
						photos = g.photos;
						construireBande();
					}
					overlay.classList.add('is-open');
					afficher(i);
					overlay.classList.add('is-open');
					overlay.setAttribute('aria-hidden', 'false');
					document.body.style.overflow = 'hidden';
					btnClose.focus({ preventScroll: true });
				}
				function fermer() {
					arreter();
					if (document.fullscreenElement) document.exitFullscreen?.();
					overlay.classList.remove('is-open');
					overlay.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					// Ramène la page sur la dernière photo regardée.
					const img = photos[courant];
					img.scrollIntoView({ block: 'center' });
					(img === declencheur ? img : declencheur)?.focus?.({ preventScroll: true });
				}

				groupeDe.forEach(({ g, i }, img) => {
					img.tabIndex = 0;
					img.setAttribute('role', 'button');
					img.setAttribute('aria-label', `Agrandir la photo ${i + 1} sur ${g.photos.length}`);
					img.addEventListener('click', (e) => {
						e.preventDefault();
						ouvrir(img);
					});
					img.addEventListener('keydown', (e) => {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							ouvrir(img);
						}
					});
				});

				if (document.fullscreenEnabled) {
					btnFull.hidden = false;
					btnFull.addEventListener('click', () =>
						document.fullscreenElement ? document.exitFullscreen() : overlay.requestFullscreen()
					);
					document.addEventListener('fullscreenchange', () => {
						btnFull.textContent = document.fullscreenElement ? 'Quitter le plein écran' : 'Plein écran';
					});
				}

				btnClose.addEventListener('click', fermer);
				btnPlay.addEventListener('click', bascule);
				$('lb-prev').addEventListener('click', precedente);
				$('lb-next').addEventListener('click', suivante);
				stage.addEventListener('click', (e) => {
					if (e.target === stage) fermer();
				});

				// Balayage sur téléphone et tablette
				let x0 = null;
				let y0 = null;
				stage.addEventListener('touchstart', (e) => {
					if (e.touches.length !== 1) return (x0 = null);
					x0 = e.touches[0].clientX;
					y0 = e.touches[0].clientY;
				}, { passive: true });
				stage.addEventListener('touchend', (e) => {
					if (x0 === null) return;
					const dx = e.changedTouches[0].clientX - x0;
					const dy = e.changedTouches[0].clientY - y0;
					x0 = null;
					if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) (dx < 0 ? suivante : precedente)();
				});

				document.addEventListener('keydown', (e) => {
					if (!overlay.classList.contains('is-open')) return;
					switch (e.key) {
						case 'Escape': fermer(); break;
						case 'ArrowLeft': precedente(); break;
						case 'ArrowRight': suivante(); break;
						case 'Home': arreter(); afficher(0); break;
						case 'End': arreter(); afficher(photos.length - 1); break;
						case ' ':
							if (e.target.tagName !== 'BUTTON') { e.preventDefault(); bascule(); }
							break;
						case 'Tab': {
							// Garde le focus dans la visionneuse
							const focusables = Array.from(overlay.querySelectorAll('button:not([hidden])'))
								.filter((b) => b.offsetParent !== null);
							const premier = focusables[0];
							const dernier = focusables[focusables.length - 1];
							if (e.shiftKey && document.activeElement === premier) { e.preventDefault(); dernier.focus(); }
							else if (!e.shiftKey && document.activeElement === dernier) { e.preventDefault(); premier.focus(); }
							break;
						}
					}
				});
			})();
		</script>
	</body>
</html>
