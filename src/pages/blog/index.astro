---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Expositions — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<p class="eyebrow">Archives · Musée Paul Valéry</p>
				<h1>Expositions</h1>
				<p class="subtitle">
					{posts.length} reportages photographiques consacrés aux expositions, accrochages et événements du musée.
				</p>
			</div>

			<section class="expositions-grid">
				{
					posts.map((post) => (
						<article class="card">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<div class="image-wrap">
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
									</div>
								)}
								<div class="card-content">
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('fr-FR', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										})}
									</time>
									<h2>{post.data.title}</h2>
								</div>
							</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		max-width: 720px;
		margin-bottom: 3.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.eyebrow {
		font-size: 0.78rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.75rem;
		font-weight: 500;
	}
	.subtitle {
		color: rgb(var(--gray));
		font-size: 1.05rem;
		margin: 0.75rem 0 0 0;
	}
	.expositions-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 3rem 2.5rem;
	}
	.card a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.image-wrap {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background-color: rgb(var(--gray-light));
		margin-bottom: 1.25rem;
		border-radius: 2px;
	}
	.image-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		box-shadow: none;
		transition: transform 0.5s ease;
	}
	.card a:hover .image-wrap img {
		transform: scale(1.03);
	}
	.card-content {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	time {
		display: block;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.5rem;
	}
	.card h2 {
		font-size: 1.45rem;
		line-height: 1.3;
		margin: 0;
		transition: color 0.2s ease;
	}
	.card a:hover h2 {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.expositions-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}
</style>