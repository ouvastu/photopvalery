---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { estJournees, parDate } from '../../lib/rubriques';

const posts = (await getCollection('blog')).filter((p) => !estJournees(p)).sort(parDate);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Expositions — ${SITE_TITLE}`}
			description="Reportages photographiques de Gilles Hutchinson sur les expositions, accrochages et vernissages du Musée Paul Valéry de Sète."
		/>
	</head>
	<body>
		<Header />
		<main>
			<PostList
				posts={posts}
				eyebrow="Archives · Musée Paul Valéry"
				title="Expositions"
				subtitle={`${posts.length} reportages photographiques consacrés aux expositions, accrochages et vernissages du musée.`}
			/>
		</main>
		<Footer />
	</body>
</html>
