---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Photographies au Musée Paul Valéry</h1>
			<p>
				Bienvenue sur ce site dédié aux archives photographiques des expositions, vernissages et événements du Musée Paul Valéry de Sète.
			</p>
			<p>
				Parcourez l'ensemble des galeries dans la rubrique <a href="/blog">Expositions</a> : cliquez sur n'importe quelle photographie pour l'afficher en plein écran ou lancer le diaporama.
			</p>
		</main>
		<Footer />
	</body>
</html>