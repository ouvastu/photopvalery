---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTEUR, MUSEE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { estJournees, parDate, photoDeCouverture } from '../lib/rubriques';

const posts = (await getCollection('blog')).sort(parDate);

const colonnes = [
	{
		id: 'expositions',
		titre: 'Expositions',
		lien: '/blog',
		articles: posts.filter((p) => !estJournees(p)),
	},
	{
		id: 'journees',
		titre: 'Journées Paul Valéry',
		lien: '/journees-paul-valery',
		articles: posts.filter(estJournees),
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: new URL('/', Astro.site).href,
	description: SITE_DESCRIPTION,
	inLanguage: 'fr',
	author: AUTEUR,
	publisher: AUTEUR,
	about: MUSEE,
};

const jourMois = (date: Date) => date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Musée Paul Valéry, Sète : expositions et Journées en photos"
			description={SITE_DESCRIPTION}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header />
		<main class="home">
			<div class="intro">
				<p class="eyebrow">Archives photographiques · Sète</p>
				<h1>Expositions et Journées Paul Valéry</h1>
				<p class="lead">
					Expositions, vernissages, accrochages et rencontres qui ont marqué la vie du Musée Paul Valéry.
				</p>
			</div>

			<div class="colonnes">
				{
					colonnes.map((col) => (
						<section class="colonne" aria-labelledby={`titre-${col.id}`}>
							<h2 id={`titre-${col.id}`}>
								<a href={col.lien}>{col.titre}</a>
								<span class="compte">{col.articles.length} reportages</span>
							</h2>
							<ol class="frise">
								{col.articles.map((post) => {
									const photo = photoDeCouverture(post);
									return (
										<li>
											<a href={`/blog/${post.id}/`}>
												<span class="annee">{post.data.pubDate.getFullYear()}</span>
												<span class="repere" aria-hidden="true" />
												<span class="vignette">
													{photo && (
														<img
															src={photo.src}
															width={photo.w}
															height={photo.h}
															alt=""
															loading="lazy"
															decoding="async"
														/>
													)}
												</span>
												<span class="texte">
													<span class="titre">{post.data.title}</span>
													<time datetime={post.data.pubDate.toISOString()}>
														{jourMois(post.data.pubDate)}
													</time>
												</span>
											</a>
										</li>
									);
								})}
							</ol>
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		max-width: min(760px, 100%);
		margin-bottom: 3.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.eyebrow {
		font-size: 0.78rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 1.25rem;
		font-weight: 500;
	}
	h1 {
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		margin-bottom: 1.25rem;
		line-height: 1.12;
	}
	.lead {
		font-size: 1.15rem;
		color: rgb(var(--gray));
		max-width: 600px;
		margin: 0;
	}
	.colonnes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 3rem 3.5rem;
		align-items: start;
	}
	.colonne h2 {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		font-size: 1.6rem;
		margin: 0 0 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid rgb(var(--black));
	}
	.colonne h2 a {
		color: rgb(var(--black));
	}
	.colonne h2 a:hover {
		color: var(--accent);
	}
	.compte {
		font-family: var(--font-atkinson), sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		white-space: nowrap;
	}

	/* ---------- Frise chronologique ---------- */
	.frise {
		--annee: 3.1rem;
		--rail: 1.5rem;
		--vignette: 92px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.frise li {
		position: relative;
		margin: 0;
	}
	/* Le fil vertical, continu d'un reportage à l'autre */
	.frise li::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--annee) + var(--rail) / 2);
		width: 1px;
		background-color: rgb(var(--gray-light));
	}
	.frise li:first-child::before {
		top: 1.55rem;
	}
	.frise li:last-child::before {
		bottom: calc(100% - 1.55rem);
	}
	.frise a {
		display: grid;
		grid-template-columns: var(--annee) var(--rail) var(--vignette) minmax(0, 1fr);
		align-items: start;
		padding: 0.85rem 0;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.annee {
		padding-top: 0.15rem;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.05rem;
		color: rgb(var(--gray));
		text-align: right;
		font-variant-numeric: lining-nums tabular-nums;
	}
	.repere {
		position: relative;
		height: 1.4rem;
	}
	/* Le point sur le fil, aligné sur l'année */
	.repere::after {
		content: '';
		position: absolute;
		top: 0.7rem;
		left: 50%;
		width: 7px;
		height: 7px;
		border: 1px solid rgb(var(--gray));
		border-radius: 50%;
		background-color: #faf9f6;
		transform: translate(-50%, 0);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.vignette {
		display: block;
		width: var(--vignette);
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 2px;
		background-color: rgb(var(--gray-light));
	}
	.vignette img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		box-shadow: none;
		border-radius: 0;
		transition: transform 0.4s ease;
	}
	.texte {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.1rem 0 0 1rem;
	}
	.titre {
		font-size: 1rem;
		line-height: 1.4;
		transition: color 0.2s ease;
	}
	time {
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.frise a:hover .titre,
	.frise a:focus-visible .titre {
		color: var(--accent);
	}
	.frise a:hover .repere::after,
	.frise a:focus-visible .repere::after {
		background-color: var(--accent);
		border-color: var(--accent);
	}
	.frise a:hover .vignette img {
		transform: scale(1.06);
	}

	@media (max-width: 720px) {
		.colonnes {
			grid-template-columns: 1fr;
		}
		.frise {
			--annee: 2.7rem;
			--rail: 1.25rem;
			--vignette: 72px;
		}
		.annee {
			font-size: 0.95rem;
		}
		.titre {
			font-size: 0.95rem;
		}
		.texte {
			padding-left: 0.75rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.vignette img,
		.titre,
		.repere::after {
			transition: none;
		}
		.frise a:hover .vignette img {
			transform: none;
		}
	}
</style>
